# Copy this to .env and fill in the real token from BotFather.
TELEGRAM_BOT_TOKEN=replace-me

# Optional but recommended: only answer in groups where this Telegram user is a member.
# Get this from @userinfobot or a similar Telegram ID lookup bot.
OWNER_TELEGRAM_ID=123456789

# Optional: host-side folder mounted to /data in Docker Compose.
TRIPSPLIT_DATA_DIR=./data

# Optional: override the SQLite file path inside the container or local machine.
# DATABASE_PATH=/data/tripsplitexpenses.sqlite3
